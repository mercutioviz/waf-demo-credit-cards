{
    email admin@democuda.org
    # AWS credentials for Route53 DNS-01 challenge are read from environment:
    # AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION
}

# Reusable TLS snippet — DNS-01 via Route53 for automatic cert issuance.
(route53_tls) {
    tls {
        dns route53
    }
}

# ── insecure side — public HTTPS on port 443 ──────────────────────────────
# Reached directly by the attack scripts with no WAF in the path.

insecure.pay.democuda.org {
    import route53_tls
    reverse_proxy checkout-insecure:5000
}

# ── secure side — plain HTTP on port 8081 ─────────────────────────────────
# Azure NSG restricts :8081 to Barracuda WaaS source IP ranges only.
# WaaS is configured with origin = <host-ip>:8081 and preserves the Host header.
# Port 8080 is unavailable on this host — the waf-training-wordpress stack has it.

:8081 {
    @checkout host secure.pay.democuda.org

    handle @checkout {
        reverse_proxy checkout-secure:5000
    }

    handle {
        respond "Not found" 404
    }
}
