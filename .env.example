# Copy to .env and fill in values before running docker compose.
# Never commit .env to version control.

# Hostnames. Moving the lab to a different zone is a change to this block and
# nothing else -- Caddy, the Makefile and the attack scripts all read from here.
# The Route53 credentials below must have access to whichever zone you pick.
INSECURE_HOST=insecure.pay.democuda.org
SECURE_HOST=secure.pay.democuda.org
ACME_EMAIL=admin@democuda.org

# Comma-separated domain suffixes the attack scripts will run against without
# --force. localhost and 127.0.0.1 are always permitted and need not be listed.
LAB_DOMAINS=.democuda.org

# Route53 credentials for Caddy DNS-01 certificate issuance
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Seeds the fake issuer's live-card oracle. Any non-empty string works.
# Demos are repeatable only while this value is stable — changing it changes
# which test cards authorize.
LAB_SECRET=change-me-lab-secret

# Percentage of generated test cards the fake issuer treats as live.
# 2 is realistic for a carding run against a stale dump. Raise it to 10 if you
# want the demo to find hits faster in front of an audience.
LIVE_RATE=2
